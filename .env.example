# Copy to .env. Keep provider credentials local and never commit them.
# Replace the required Grafana password before starting the stack.

# Select "none" for rules-only operation or "openai_compat" for a configured provider.
LLM_PROVIDER=none
# Set the provider's OpenAI-compatible base URL when LLM_PROVIDER is enabled.
LLM_BASE_URL=
# Optional API key for providers that require authentication; leave blank in this template.
LLM_API_KEY=
# Set the provider's model identifier when LLM_PROVIDER is enabled.
LLM_MODEL=
# Maximum duration of one provider request, in seconds.
LLM_TIMEOUT_S=20
# Maximum number of retries after a failed provider request.
LLM_MAX_RETRIES=2
# Minimum seconds between provider requests from each process.
LLM_MIN_INTERVAL_S=0
# Notional USD price per million prompt tokens.
LLM_PRICE_IN_PER_1M=0.15
# Notional USD price per million completion tokens.
LLM_PRICE_OUT_PER_1M=0.60

# Number of provider failures that opens the circuit breaker.
BREAKER_FAIL_THRESHOLD=3
# Time window for counting provider failures, in seconds.
BREAKER_WINDOW_S=60
# Time before an open provider circuit permits a probe, in seconds.
BREAKER_COOLDOWN_S=20

# Maximum evidence-agent steps per run.
AGENT_MAX_STEPS=12
# Maximum tool calls per run.
AGENT_MAX_TOOL_CALLS=14
# Maximum wall-clock time per run, in seconds.
AGENT_RUN_TIMEOUT_S=45
# Maximum duration of one tool call, in seconds.
TOOL_TIMEOUT_S=5
# Maximum verification/retrieval strategies per run.
VERIFY_MAX_STRATEGIES=2
# Enable tool-directed multi-step retrieval; false selects the single-pass baseline.
AGENTIC_RETRIEVAL=true
# Versioned normalization prompt to use.
PROMPT_NORMALISE=normalise_v2

# Enable vector retrieval; requires an image built with WITH_EMBEDDINGS=1.
EMBEDDINGS_ENABLED=false
# Embedding model identifier, required only when vector retrieval is enabled.
EMBEDDING_MODEL=

# Requests allowed per client per minute.
CLIENT_RATE_LIMIT_PER_MINUTE=30
# Enable caching of completed runs.
RUN_CACHE_ENABLED=true
# Concurrent queue-claim loops in each worker process.
WORKER_CONCURRENCY=4
# Fraction of completed live runs sampled for reference-free quality scoring.
QUALITY_SAMPLE_RATE=0.25
# Trust X-Forwarded-For when deriving the client address.
TRUST_PROXY=true
# Demo-only fault injection mode; normally blank.
FAULT_INJECTION=

# Required: set a unique local Grafana administrator password before Compose startup.
GRAFANA_PASSWORD=

# Host port for the REST API (container port 8000).
API_HOST_PORT=8000
# Host port for the web client (container port 80).
WEB_HOST_PORT=8080
# Host port for Prometheus (container port 9090).
PROMETHEUS_HOST_PORT=9090
# Host port for cAdvisor metrics (container port 8080).
CADVISOR_HOST_PORT=8081
# Host port for Jaeger UI (container port 16686).
JAEGER_HOST_PORT=16686
# Host port for Grafana (container port 3000).
GRAFANA_HOST_PORT=3000

# Required by the load-test Compose overlay; set the stub's Compose-network URL in local .env.
LOADTEST_LLM_BASE_URL=
# Required by the load-test Compose overlay; set a local stub model identifier in .env.
LOADTEST_LLM_MODEL=
# Host port for the load-test API (container port 8000).
LOADTEST_API_HOST_PORT=18000
# Host port for the load-test LLM stub (container port 9000).
LOADTEST_LLM_STUB_HOST_PORT=19000
# Host port for the load-test Jaeger UI (container port 16686).
LOADTEST_JAEGER_HOST_PORT=16687
# Host port for the Locust UI (container port 8089).
LOCUST_HOST_PORT=18089
