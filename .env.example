# Copy to .env. Never commit credentials; configure provider details locally (D4).
# The system runs with NO model configured (rules-only mode). Add a provider to enable the LLM agent.

# --- Optional LLM provider; configure endpoint, key and model only in your local .env ---
LLM_PROVIDER=none            # none | openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_PRICE_IN_PER_1M=0.15     # notional USD per 1M prompt tokens (free tiers cost 0; this keeps L5 numbers meaningful)
LLM_PRICE_OUT_PER_1M=0.60

# --- circuit breaker ---
BREAKER_FAIL_THRESHOLD=3
BREAKER_WINDOW_S=60
BREAKER_COOLDOWN_S=20

# --- agent loop bounds (A1) ---
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=14
AGENT_RUN_TIMEOUT_S=45
TOOL_TIMEOUT_S=5
VERIFY_MAX_STRATEGIES=2
AGENTIC_RETRIEVAL=true       # false = single-pass baseline (used for the L3 before/after)
PROMPT_NORMALISE=normalise_v2   # or normalise_v1 (L2 prompt comparison)

# --- retrieval ---
EMBEDDINGS_ENABLED=false     # true needs an image built with WITH_EMBEDDINGS=1
EMBEDDING_MODEL=            # a sentence-transformers model name; required only when EMBEDDINGS_ENABLED=true

# --- platform ---
CLIENT_RATE_LIMIT_PER_MINUTE=30
RUN_CACHE_ENABLED=true
WORKER_CONCURRENCY=4
QUALITY_SAMPLE_RATE=0.25
TRUST_PROXY=true
FAULT_INJECTION=             # demo only: fabricated_citation

# --- observability ---
GRAFANA_PASSWORD=change-me-locally
