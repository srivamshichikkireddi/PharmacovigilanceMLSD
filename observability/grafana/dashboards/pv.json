     "expr": "histogram_quantile(0.5, sum(rate(pv_run_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum(rate(pv_run_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
