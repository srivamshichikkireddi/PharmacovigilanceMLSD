   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(pv_runs_total[1m])) by (route)",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Error rate",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(sum(rate(pv_runs_total{status=\"failed\"}[1m])) or vector(0)) / clamp_min(sum(rate(pv_runs_total[1m])),1e-9)",
     "legendFormat": "failed runs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(sum(rate(pv_api_requests_total{status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(pv_api_requests_total[1m])),1e-9)",
     "legendFormat": "API 5xx",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
